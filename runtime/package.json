{
  "name": "@fleur/runtime",
  "private": true,
  "version": "0.1.0",
  "description": "Fleur browser runtime built with Bun",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/index.ts --target browser --format iife --minify --outfile ../src/fleur/assets/fleur.js",
    "build:dev": "bun build ./src/index.ts --target browser --format iife --sourcemap --outfile ../src/fleur/assets/fleur.js",
    "check": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
